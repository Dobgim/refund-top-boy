# ---------------------------------------------------------------------------
# RoyalRefund environment
# Copy to .env.local and fill in. Never commit .env.local.
# The app builds and runs without these — it falls back to labelled demo data.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical site URL. Used for SEO metadata and for the links inside the
# confirmation and password-reset emails.
#
# Set this to the live site, even in .env.local. Those emails are opened later,
# from a mail client, often on a phone -- a http://localhost:3000 link there
# resolves to nothing. Leave it blank only if you want the links to point at
# whatever origin you signed up from.
#
# The same URL must be allow-listed in Supabase:
#   Authentication -> URL Configuration
#     Site URL:      https://www.getroyalrefund.com
#     Redirect URLs: https://www.getroyalrefund.com/auth/callback
# Supabase silently replaces any redirect it was not given permission for with
# the project's Site URL, so a stale Site URL there sends every link to it.
NEXT_PUBLIC_SITE_URL=https://www.getroyalrefund.com

# ---------------------------------------------------------------------------
# Server-only. Never prefix these with NEXT_PUBLIC_ and never expose them to
# the browser. Used solely by `npm run seed`.
# ---------------------------------------------------------------------------

# Service role key (Project Settings -> API -> service_role). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo accounts created by the seed script. Choose your own strong values.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-this-to-something-long
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=change-this-to-something-long

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (optional) — bot protection on the public forms.
# Get a free pair at https://dash.cloudflare.com -> Turnstile -> Add site.
# Leave both blank and every form works exactly as before, unprotected.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Transactional email, through Resend.
#
# Without RESEND_API_KEY nothing is sent: the app stays fully usable, every
# submission still reaches the admin console, and each skipped message is
# logged. Set the key and the notices below start arriving.
#
# The sending domain must be verified in Resend first, otherwise the API
# rejects the send. Get a key at https://resend.com -> API Keys.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# The From address. Its domain has to be the one verified in Resend.
EMAIL_FROM=RoyalRefund <support@getroyalrefund.com>

# Where operational notices land: a new claim, a contact-form message, an
# identity document, a withdrawal request, a loan application, and a customer
# replying on their case.
#
# Accepts a comma-separated list, so a personal inbox can be copied without
# setting up forwarding. No spaces are needed; they are trimmed either way.
#
#   EMAIL_ADMIN=support@getroyalrefund.com,you@gmail.com
EMAIL_ADMIN=support@getroyalrefund.com

# Where a customer's reply goes when they hit Reply. Defaults to EMAIL_ADMIN.
EMAIL_REPLY_TO=support@getroyalrefund.com

# ---------------------------------------------------------------------------
# Supabase's own auth mail (confirmation, password reset) is sent by Supabase,
# not by this application. Its built-in sender is rate limited to a few an hour
# and often lands in spam, so route it through the same domain:
#
#   Supabase -> Project Settings -> Authentication -> SMTP Settings
#     Host:     smtp.resend.com
#     Port:     587
#     Username: resend
#     Password: your Resend API key
#     Sender:   support@getroyalrefund.com
# ---------------------------------------------------------------------------
